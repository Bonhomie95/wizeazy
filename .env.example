# --- MongoDB ---
# Connection string from your MongoDB Atlas cluster (or any MongoDB instance).
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database name to use inside the cluster (created automatically if it doesn't exist).
MONGODB_DB=wizeazy

# --- Admin ---
# Password required to unlock /admin. No username — password only.
# Keep this secret. Generate a new one any time with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64url'))"
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. Any long random string works.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
